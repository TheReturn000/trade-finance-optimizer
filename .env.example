# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trade_finance_db
# For local SQLite development:
# DATABASE_URL=sqlite:///./trade_finance.db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# External APIs
WORLD_BANK_API_BASE=https://api.worldbank.org/v2
IMF_API_BASE=https://www.imfstatistical.org/imfbluebook/
FAO_API_BASE=http://fenixservices.fao.org/faostat/api/v1
USDA_API_KEY=your_usda_api_key_here

# Sanctions & Compliance
OFAC_API_BASE=https://sanctionssearch.ofac.treas.gov/

# Data Source Refresh Intervals (in hours)
COMMODITY_REFRESH_INTERVAL=720  # 30 days
TRADE_FLOW_REFRESH_INTERVAL=720
MACRO_REFRESH_INTERVAL=168     # 7 days
SANCTIONS_REFRESH_INTERVAL=24  # Daily

# Logging
LOG_LEVEL=INFO

# Feature Flags
USE_CACHE=True
DEBUG_MODE=False
