# Database
DATABASE_URL=sqlite:///./commodity_reports.db
# DATABASE_URL=postgresql://user:password@localhost:5432/commodity_reports

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Scheduler
SCHEDULER_ENABLED=True

# Report Output
REPORT_OUTPUT_DIR=./static/reports
EXPORT_OUTPUT_DIR=./static/exports

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/reports.log

# Feature Flags
USE_CACHE=True
DEBUG_MODE=False
